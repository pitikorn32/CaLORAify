{
	"name": "caloraify",
	"image": "pitikorn32/cuda:12.1.0-devel-ubuntu20.04",

	// Run in GPU
	"runArgs": [
		"--gpus",
		"all",
		"--shm-size=48g",
		"--name",
		"caloraify"
	],

	"containerEnv": {
		"HF_HOME": "/workspaces/HF_cache",
		"HF_DATASETS_CACHE": "/workspaces/HF_cache"
	},

	// 👇 Features to add to the Dev Container. More info: https://containers.dev/implementors/features.
	// "features": {},

	// 👇 Use 'forwardPorts' to make a list of ports inside the container available locally.
	"forwardPorts": [
		19090,
		19091
	],

	// 👇 Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "",

	// 👇 Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.black-formatter",
				"ms-toolsai.jupyter",
				"oderwat.indent-rainbow",
				"github.copilot",
				"mhutchie.git-graph"
			]
		}
	},

	// 👇 Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	"remoteUser": "root",

	"mounts": [
		"source=/home/p13liam/Petanque/Work/Datasets,target=/workspaces/Datasets,type=bind,consistency=cached",
		"source=/home/p13liam/Petanque/Work/HF_cache,target=/workspaces/HF_cache,type=bind,consistency=cached"
	]
}
